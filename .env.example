# Local Docker Compose values only. These intentionally fail production-mode validation.
POSTGRES_DB=amf
POSTGRES_USER=amf
POSTGRES_PASSWORD=amf-local-only
POSTGRES_HOST_PORT=5432

DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=unsafe-local-development-key-do-not-use-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
AUTH_RATE_LIMIT_HMAC_KEY=unsafe-local-rate-limit-key
AUTH_EMAIL_OUTBOX_RETENTION_SECONDS=2592000
PUBLIC_APP_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=AMF <no-reply@amf.local>
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
BACKEND_PORT=8000
FRONTEND_PORT=5173
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025